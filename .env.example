# Django settings
SECRET_KEY=<required>
ADMIN_URL=<required-for-production>
MEDIA_ROOT=<required-for-production>
ALLOWED_HOSTS=<required-for-production>
CSRF_TRUSTED_ORIGINS=<required-for-production>

# Database (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=postgres

# EuroPMC URLs for publications page
# the urls can be left as is
EUROPE_PMC_API_URL=https://www.ebi.ac.uk/europepmc/webservices/rest/search?sortBy=FIRST_PDATE_D+desc&resultType=core&format=json&pageSize=10
EUROPE_PMC_WEB_URL=https://europepmc.org/search

# REVIEW: Security (prod toggles)
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# REVIEW Gunicorn (prod)
GUNICORN_WORKERS=2
GUNICORN_THREADS=4

# Optional local dev settings

# set to 'true' if you wanna
# use 'graph_models' command
# of 'django-extensions'
with_pygraphviz=false
